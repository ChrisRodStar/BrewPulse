#!/bin/sh

protected_ref="refs/heads/main"

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" != "$protected_ref" ]; then
    continue
  fi

  cat >&2 <<'MESSAGE'
BrewPulse safeguard: direct pushes to main are blocked.

Push a feature branch and open a pull request. Merge only after the latest required
validation passes.
MESSAGE
  exit 1
done

exit 0
